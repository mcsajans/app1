{
  "expo": {
    "name": "Bebiqa",
    "slug": "bebiqa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFBFD",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bebiqa.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bebiqa.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "./plugins/withCmakeObjectPathMax",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4C8DF6",
          "defaultChannel": "reminders_v2",
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/notification/bildirim1.mp3",
            "./assets/notification/bildirim2.mp3",
            "./assets/notification/bildirim3.mp3",
            "./assets/notification/bildirim4.mp3",
            "./assets/notification/bildirim5.mp3",
            "./assets/notification/bildirim6.mp3",
            "./assets/notification/bildirim7.mp3",
            "./assets/notification/bildirim8.mp3"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Bebiqa, görev ve hatırlatıcıları telefonunun takvimine yazmak için takvim erişimi istiyor.",
          "writeOnlyCalendarPermission": "Bebiqa, görev ve hatırlatıcıları telefonunun takvimine yazmak için izin istiyor. Mevcut randevuların okunmaz.",
          "writeOnlyAccess": true
        }
      ],
      [
